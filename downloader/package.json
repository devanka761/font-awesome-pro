{
  "name": "fapro-downloader",
  "version": "0.1.0",
  "description": "Font Awesome Pro+ Downloader",
  "author": "Devanka761 <contact@devanka.id> (https://devanka.id/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devanka761/font-awesome-pro.git"
  },
  "bugs": {
    "url": "https://github.com/devanka761/font-awesome-pro/issues"
  },
  "homepage": "https://github.com/devanka761/font-awesome-pro#readme",
  "keywords": [
    "font-awesome-pro",
    "fontawesomepro",
    "font-awesome",
    "fontawesome",
    "font-awesome-pro-downloader",
    "font-awesome-downloader",
    "font",
    "webfont",
    "font-face"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "type-check": "tsc -p . --pretty --noEmit",
    "lint": "eslint --ext ts --ext tsx --ext js",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "create": "tsx ./src/create/start.ts",
    "build": "npm run lint && npm run type-check && npm run format  && tsc --emitDeclarationOnly && tsx ./src/build.ts",
    "version:patch": "npm --no-git-tag-version version patch",
    "version:minor": "npm --no-git-tag-version version minor",
    "version:major": "npm --no-git-tag-version version major",
    "pre:patch": "npm --no-git-tag-version version prepatch && npm --no-git-tag-version version prerelease --preid wip",
    "pre:minor": "npm --no-git-tag-version version preminor && npm --no-git-tag-version version prerelease --preid wip",
    "pre:major": "npm --no-git-tag-version version premajor && npm --no-git-tag-version version prerelease --preid wip",
    "pre:release": "npm --no-git-tag-version version prerelease",
    "svg-singles": "tsx ./src/create/uploadSingles.ts",
    "svg-full-singles": "tsx ./src/create/uploadFullSingles.ts",
    "svg-sprites": "tsx ./src/create/uploadSprites.ts"
  },
  "dependencies": {
    "log-update": "^8.0.0",
    "nodejs-file-downloader": "^4.13.0",
    "postcss": "^8.5.16",
    "postcss-safe-parser": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/postcss-safe-parser": "^5.0.4",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
